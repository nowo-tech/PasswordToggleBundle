# PHPStan configuration for Password Toggle Bundle
# Compatible with PHP 8.2+ and Symfony 7.x / 8.x

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - demo/*

includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/nowo-tech/phpstan-frankenphp/extension.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
    # worker-strict includes worker rules and also flags request-superglobal access (REQ-FP-001)
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker-strict.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-hardening.neon
