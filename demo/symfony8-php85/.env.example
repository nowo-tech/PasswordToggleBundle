###> symfony/framework-bundle ###
# APP_ENV: Symfony environment (dev/test/prod). Demos use `dev`.
APP_ENV=dev
# APP_SECRET: secret for signing cookies/CSRF. Use a local-only placeholder in demos.
APP_SECRET=change_this_secret_key_to_a_random_value
# APP_DEBUG: enable detailed debug output (`1` in demos).
APP_DEBUG=1

# FRANKENPHP_MODE: FrankenPHP runtime mode — `classic` (one process per request) or `worker` (long-lived workers).
# Default: worker. Set classic for per-request PHP / easier hot-reload. Recreate with `docker compose up -d` after change.
FRANKENPHP_MODE=worker
###< symfony/framework-bundle ###

###> symfony/console ###
# In case the app is run behind a reverse proxy, set the trusted proxies
# Read https://symfony.com/doc/current/deployment/proxies.html
#TRUSTED_PROXIES=127.0.0.1,127.0.0.2
#TRUSTED_HOSTS='^localhost|example\.com$'
###< symfony/console ###

# PORT: Host port mapped to the demo HTTP service.
PORT=8004

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost:8004
###< symfony/routing ###
