{% extends 'base.html.twig' %}

{% set _core = app.request.attributes.get('_route') == 'demo_core_password' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Password Toggle Bundle',
        intro: _core ? "Symfony's own PasswordType gets the toggle through extend_core_password_type; toggle: false opts a field out." : 'Symfony bundle demo: a password field with a show/hide toggle.',
    }) }}
{% endblock %}

{% block nowo_ui_flashes %}
    {{ include('@NowoUiKit/demo_platform/_flashes.html.twig', {flash_messages: submitted ? {success: ['Form submitted successfully! Username: ' ~ data.username ~ '. Password: ******** (hidden for security). The password toggle functionality is working correctly!']} : null}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: _core ? 'Symfony PasswordType' : 'Toggle field', kind: 'form', testid: 'demo-case'} %}
        {% block section_body %}
            {{ form_start(form, { attr: { id: 'demo-form', class: 'nowo-ui-form', novalidate: 'novalidate' } }) }}
                {# REQ-TWIG-003: child loop #}
                {% for child in form %}
                    {% if not child.rendered and child.vars.name != 'submit' %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
                {% do form.submit.setRendered %}
            {{ form_end(form) }}
        {% endblock %}
        {% block section_footer %}
            <button type="submit" form="demo-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ form.submit.vars.label }}</button>
        {% endblock %}
    {% endembed %}
{% endblock %}
