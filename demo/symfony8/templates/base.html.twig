{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell. This file only declares the demo. The toggle
    stylesheet is the PasswordToggleBundle's own asset. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'Password Toggle',
    home_route: 'demo_form',
    repository: 'https://github.com/nowo-tech/PasswordToggleBundle',
    translation_domain: false,
    nav: [
        {label: 'Toggle field', route: 'demo_form', section: 'Demos'},
        {label: 'Symfony PasswordType', route: 'demo_core_password', section: 'Demos'},
    ],
} %}
{% block nowo_ui_document_title %}{% block title %}Password Toggle Bundle - Demo{% endblock %}{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {# PasswordToggleBundle: one eye at a time is driven by this stylesheet (without it both icons show). #}
    <link href="{{ asset('/bundles/nowopasswordtoggle/css/toggle_password.css') }}" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
{% endblock %}
