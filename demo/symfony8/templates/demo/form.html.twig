{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Password Toggle Bundle',
        intro: 'Symfony bundle demo: a password field with a show/hide toggle.',
    }) }}
{% endblock %}

{% block body %}
    {% if submitted %}
        <div class="nowo-ui-flash nowo-ui-flash--success" role="alert">
            <strong>Form submitted successfully!</strong>
            Username: {{ data.username }}. Password: ******** (hidden for security). The password toggle functionality is working correctly!
        </div>
    {% endif %}

    <section class="nowo-ui-card" data-testid="demo-case">
        <div class="nowo-ui-card__body">
            {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
                {# REQ-TWIG-003: child loop #}
                {% for child in form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(form) }}
        </div>
    </section>

    <p class="nowo-ui-muted">Powered by <a class="nowo-ui-link" href="https://github.com/nowo-tech/PasswordToggleBundle" target="_blank" rel="noopener">Password Toggle Bundle</a></p>
{% endblock %}
